<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>osu-pp</AssemblyName>
    <RootNamespace>OsuLocalProfiles.PpCalculator</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <!--
    No trimming settings here on purpose. The slim helper is trimmed by scripts/build-pp-helper.mjs
    (SLIM_PUBLISH_ARGS), which builds the full one beside it and ships the slim one only when
    scripts/pp-parity.mjs finds every answer identical (roadmap 5.60). A setting here would trim
    every publish, checked or not.
  -->
  <ItemGroup>
    <PackageReference Include="ppy.osu.Game" Version="2026.916.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Osu" Version="2026.916.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Taiko" Version="2026.916.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Catch" Version="2026.916.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Mania" Version="2026.916.0" />
  </ItemGroup>
  <!--
    Patched versions of what ppy.osu.Game brings in, where the fix is a drop-in: osu!'s online
    multiplayer client, which the helper never connects. Checked with scripts/pp-parity.mjs, every
    answer identical. Once osu.Game asks for a newer one, restore fails with NU1605 (a downgrade):
    then delete that line, as osu.Game has the fix itself.
  -->
  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.NewtonsoftJson" Version="10.0.15" />
  </ItemGroup>
  <!-- The advisories left, which have no drop-in fix, and why each is suppressed. -->
  <Import Project="NuGetAudit.props" />
</Project>
